# ADS-B Guard — gizli anahtarlar sablonu
# ------------------------------------------------------------------
# Bu dosyayi 'secrets.toml' olarak kopyala ve degerleri doldur.
# Streamlit Community Cloud'da: uygulama ayarlari -> Secrets bolumune yapistir.
# YEREL: .streamlit/secrets.toml (git'e KOYMA — .gitignore'da).
#
# HEPSI OPSIYONEL — anahtarsiz da calisir (dusuk kota, sablon rapor).

# OpenSky ucretsiz hesap (anonim ~400/gun yerine 4000/gun kota)
# Kayit: https://opensky-network.org
OPENSKY_USER = ""
OPENSKY_PASS = ""

# Claude AI tehdit raporu (yoksa sablon rapor kullanilir)
# Anahtar: https://console.anthropic.com
ANTHROPIC_API_KEY = ""

# Telegram bildirim (opsiyonel)
TELEGRAM_BOT_TOKEN = ""
TELEGRAM_CHAT_ID = ""

# Discord bildirim (opsiyonel)
DISCORD_WEBHOOK_URL = ""

# Deniz (AIS) canli besleme (opsiyonel)
# Anahtar: https://aisstream.io
AISSTREAM_KEY = ""
